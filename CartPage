import React, { useState } from 'react';
import { useCart } from '../context/CartContext';

function Cart() {
  const { cart, setCart, removeFromCart, clearCart } = useCart();
  const [showPopup, setShowPopup] = useState(false);

  // Update quantity handler
  const updateQuantity = (id, newQty) => {
    setCart((prev) =>
      prev.map((item) =>
        item.id === id ? { ...item, quantity: newQty } : item
      )
    );
  };

  // Handle Checkout
  const handleCheckout = () => {
    clearCart();
    setShowPopup(true);
    setTimeout(() => setShowPopup(false), 4000);
  };

  // Total price
  const total = cart
    .reduce((sum, item) => sum + item.price * (item.quantity || 1), 0)
    .toFixed(2);

  return (
    <div style={{ padding: '2rem' }}>
      <h2>Your Cart</h2>

      {cart.length === 0 ? (
        <p>Your cart is empty.</p>
      ) : (
        <>
          {cart.map((item) => (
            <div
              key={item.id}
              style={{ border: '1px solid #ddd', padding: '1rem', marginBottom: '1rem' }}
            >
              <img src={item.image} alt={item.title} style={{ height: '100px' }} />
              <h3>{item.title}</h3>
              <p>Price: ${item.price}</p>
              <label>
                Quantity:
                <input
                  type="number"
                  value={item.quantity || 1}
                  min="1"
                  onChange={(e) => updateQuantity(item.id, parseInt(e.target.value))}
                  style={{ width: '60px', marginLeft: '0.5rem' }}
                />
              </label>
              <br />
              <button onClick={() => removeFromCart(item.id)} style={{ marginTop: '0.5rem' }}>
                Remove
              </button>
            </div>
          ))}

          <h3>Total: ${total}</h3>
          <button onClick={handleCheckout}>Checkout</button>
        </>
      )}

      {showPopup && (
        <div
          style={{
            marginTop: '1rem',
            background: 'green',
            color: 'white',
            padding: '1rem',
            borderRadius: '5px',
          }}
        >
          Order placed successfully!
        </div>
      )}
    </div>
  );
}

export default Cart;
